<Window x:Class="MajsoulBroadcastScorer.V27.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="雀魂直播控制中心 0.292 · 调优4测试版" Width="1360" Height="860"
        MinWidth="1100" MinHeight="720" Background="{StaticResource AppBackgroundBrush}" Foreground="{StaticResource AppTextBrush}"
        FontFamily="{StaticResource UiFont}" FontSize="13" UseLayoutRounding="True" SnapsToDevicePixels="True">
  <Window.Resources>
    <Style x:Key="EntryButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="Padding" Value="18,13"/>
      <Setter Property="Background" Value="{StaticResource AppSurfaceBrush}"/>
      <Setter Property="BorderBrush" Value="{StaticResource AppBorderBrush}"/>
      <Setter Property="MinHeight" Value="76"/>
    </Style>
    <Style x:Key="PlayerCardStyle" TargetType="Border">
      <Setter Property="Background" Value="{StaticResource AppSurfaceBrush}"/>
      <Setter Property="BorderBrush" Value="{StaticResource AppBorderBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="10"/>
      <Setter Property="Padding" Value="18"/>
      <Setter Property="Margin" Value="6,0"/>
      <Style.Triggers><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter Property="BorderBrush" Value="#69CFB2"/></Trigger></Style.Triggers>
    </Style>
    <Style x:Key="ConfirmChangesButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="#C93642"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="BorderBrush" Value="#E8656F"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="Padding" Value="24,10"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="ConfirmPill" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="White"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ConfirmPill" Property="Background" Value="#DC3030"/></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="ConfirmPill" Property="Background" Value="#A51F1F"/></Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="ConfirmPill" Property="BorderBrush" Value="White"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="ConfirmPill" Property="Opacity" Value="0.5"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <DataTemplate x:Key="PlayerDetailsTemplate">
      <StackPanel>
        <Grid>
          <Grid.Resources>
            <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}"><Setter Property="Margin" Value="0,4,8,4"/></Style>
            <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}"><Setter Property="Margin" Value="0,4,8,4"/></Style>
            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Margin" Value="10,4,0,4"/><Setter Property="MinWidth" Value="92"/></Style>
          </Grid.Resources>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="86"/><ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <TextBlock Text="姓名" VerticalAlignment="Center"/>
          <TextBox Grid.Column="1" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"/>
          <TextBlock Grid.Column="2" Text="{Binding NameSource}" VerticalAlignment="Center" Margin="5"/>
          <Button Grid.Column="3" Content="恢复 API" Tag="name" Click="RestoreApi_Click"/>
          <TextBlock Grid.Row="1" Text="持有点数" VerticalAlignment="Center"/>
          <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Score, UpdateSourceTrigger=PropertyChanged}"/>
          <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding ScoreSource}" VerticalAlignment="Center" Margin="5"/>
          <Button Grid.Row="1" Grid.Column="3" Content="恢复 API" Tag="score" Click="RestoreApi_Click"/>
          <TextBlock Grid.Row="2" Text="座位风" VerticalAlignment="Center"/>
          <ComboBox Grid.Row="2" Grid.Column="1" SelectedValuePath="Content" SelectedValue="{Binding Wind, UpdateSourceTrigger=PropertyChanged}">
            <ComboBoxItem Content="东"/><ComboBoxItem Content="南"/><ComboBoxItem Content="西"/>
            <ComboBoxItem Content="北"/><ComboBoxItem Content="?"/>
          </ComboBox>
          <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding WindSource}" VerticalAlignment="Center" Margin="5"/>
          <Button Grid.Row="2" Grid.Column="3" Content="恢复 API" Tag="wind" Click="RestoreApi_Click"/>
          <TextBlock Grid.Row="3" Text="所属队伍" VerticalAlignment="Center"/>
          <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding TeamName, UpdateSourceTrigger=PropertyChanged}"/>
          <TextBlock Grid.Row="3" Grid.Column="2" Text="{Binding TeamSource}" VerticalAlignment="Center" Margin="5"/>
          <Button Grid.Row="3" Grid.Column="3" Content="恢复 API" Tag="team" Click="RestoreApi_Click"/>
          <TextBlock Grid.Row="4" Text="立直红框" VerticalAlignment="Center"/>
          <ComboBox Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="3" SelectedValuePath="Content" SelectedValue="{Binding RiichiMode, UpdateSourceTrigger=PropertyChanged}">
            <ComboBoxItem Content="自动跟随 API"/><ComboBoxItem Content="强制 ON"/><ComboBoxItem Content="强制 OFF"/>
          </ComboBox>
          <TextBlock Grid.Row="5" Text="头像框" VerticalAlignment="Center"/>
          <ComboBox Grid.Row="5" Grid.Column="1" SelectedValuePath="Content" SelectedValue="{Binding AvatarFrameMode, UpdateSourceTrigger=PropertyChanged}">
            <ComboBoxItem Content="默认边框"/><ComboBoxItem Content="自定义头像框"/><ComboBoxItem Content="隐藏头像框"/>
          </ComboBox>
          <TextBlock Grid.Row="5" Grid.Column="2" Text="{Binding AvatarFrameStatus}" VerticalAlignment="Center" Margin="5"/>
          <Button Grid.Row="5" Grid.Column="3" Content="上传头像框" Click="UploadAvatarFrame_Click"/>
        </Grid>
        <TextBlock Margin="3,12,3,8" Foreground="#AAB3C0" TextWrapping="Wrap"
                   Text="修改资料及累计精算点后，点击“确认修改”一起保存并播出。座位风与立直红框选项即时生效。"/>
        <Button Content="确认修改" Style="{StaticResource ConfirmChangesButtonStyle}" Click="ConfirmChanges_Click" HorizontalAlignment="Right"/>
      </StackPanel>
    </DataTemplate>
  </Window.Resources>
  <Grid x:Name="MainContentRoot" Margin="22,18">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/><RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <Border BorderBrush="#2C3B4B" BorderThickness="0,0,0,1" Padding="2,0,2,15" Margin="0,0,0,18">
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Ellipse x:Name="ConnectionIndicator" Width="9" Height="9" Fill="#EF5350" Margin="0,0,10,0"/>
          <TextBlock x:Name="ApiStatusText" FontSize="14" FontWeight="SemiBold" Text="未连接"
                     AutomationProperties.Name="{Binding Text, RelativeSource={RelativeSource Self}}" AutomationProperties.LiveSetting="Polite"/>
        </StackPanel>
        <TextBox x:Name="ObsStatusText" Grid.Column="1" Text="http://127.0.0.1:17657/overlay"
                 IsReadOnly="True" IsReadOnlyCaretVisible="True" BorderThickness="0" Background="Transparent"
                 FontFamily="Consolas" FontSize="13" Foreground="{StaticResource AppMutedTextBrush}" MinHeight="0"
                 HorizontalAlignment="Right" VerticalAlignment="Center" Padding="4,0" Margin="0"
                 AutomationProperties.Name="OBS 浏览器源网址" ToolTip="选中后可复制到 OBS 浏览器源"/>
      </Grid>
    </Border>

    <UniformGrid Grid.Row="1" Columns="4" Margin="-6,0,-6,22">
      <Button Style="{StaticResource EntryButtonStyle}" Click="OpenObservationControl_Click" Margin="6,0" AutomationProperties.Name="观战登录">
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <StackPanel><TextBlock Text="观战登录" FontSize="15" FontWeight="SemiBold"/><TextBlock Text="账号与大会对局" FontSize="12" Foreground="{StaticResource AppMutedTextBrush}" Margin="0,5,0,0"/></StackPanel>
          <TextBlock Grid.Column="1" Text="›" FontSize="24" Foreground="#7D9B9F" VerticalAlignment="Center" Margin="10,0,0,0"/>
        </Grid>
      </Button>
      <Button Style="{StaticResource EntryButtonStyle}" Click="OpenObservationMode_Click" Margin="6,0" AutomationProperties.Name="延迟/实时观战">
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <StackPanel><TextBlock Text="延迟/实时观战" FontSize="15" FontWeight="SemiBold"/><TextBlock Text="观战方式与画面延迟" FontSize="12" Foreground="{StaticResource AppMutedTextBrush}" Margin="0,5,0,0"/></StackPanel>
          <TextBlock Grid.Column="1" Text="›" FontSize="24" Foreground="#7D9B9F" VerticalAlignment="Center" Margin="10,0,0,0"/>
        </Grid>
      </Button>
      <Button Style="{StaticResource EntryButtonStyle}" Click="OpenReports_Click" Margin="6,0" AutomationProperties.Name="对局记录">
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <StackPanel><TextBlock Text="对局记录" FontSize="15" FontWeight="SemiBold"/><TextBlock Text="逐局详情与报告文件" FontSize="12" Foreground="{StaticResource AppMutedTextBrush}" Margin="0,5,0,0"/></StackPanel>
          <TextBlock Grid.Column="1" Text="›" FontSize="24" Foreground="#7D9B9F" VerticalAlignment="Center" Margin="10,0,0,0"/>
        </Grid>
      </Button>
      <Button Style="{StaticResource EntryButtonStyle}" Click="OpenPreview_Click" Margin="6,0" AutomationProperties.Name="实时预览">
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <StackPanel><TextBlock Text="实时预览" FontSize="15" FontWeight="SemiBold"/><TextBlock Text="定位悬浮预览窗口" FontSize="12" Foreground="{StaticResource AppMutedTextBrush}" Margin="0,5,0,0"/></StackPanel>
          <TextBlock Grid.Column="1" Text="›" FontSize="24" Foreground="#7D9B9F" VerticalAlignment="Center" Margin="10,0,0,0"/>
        </Grid>
      </Button>
    </UniformGrid>

    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,2,0">
      <StackPanel>
        <Border Background="{StaticResource AppSurfaceBrush}" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="18,14" Margin="0,0,0,14">
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="92"/><ColumnDefinition Width="270"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <TextBlock Text="OBS 样式" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
            <ComboBox x:Name="OverlayStyleComboBox" Grid.Column="1" SelectedValuePath="Content" SelectionChanged="OverlayStyle_Changed" AutomationProperties.Name="OBS 样式">
              <ComboBoxItem Content="竖排头像"/><ComboBoxItem Content="竖排头像·芙莉莲"/><ComboBoxItem Content="竖排头像·赛事展示"/>
              <ComboBoxItem Content="队伍模式"/><ComboBoxItem Content="分差与逆转"/>
            </ComboBox>
            <TextBlock x:Name="OverlayStyleStatusText" Grid.Column="2" Margin="20,0,0,0" FontSize="12" Foreground="{StaticResource AppMutedTextBrush}" VerticalAlignment="Center" TextWrapping="Wrap"/>
          </Grid>
        </Border>

        <GroupBox x:Name="VerticalMatchSettingsGroup" Header="赛事展示内容" Margin="0,0,0,14" Padding="18,14">
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="80"/><ColumnDefinition Width="*"/><ColumnDefinition Width="100"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <TextBlock Text="名称内容" VerticalAlignment="Center"/>
            <ComboBox x:Name="VerticalNameComboBox" Grid.Column="1" SelectedValuePath="Content" SelectionChanged="VerticalContent_Changed">
              <ComboBoxItem Content="所属队伍"/><ComboBoxItem Content="选手姓名"/>
            </ComboBox>
            <TextBlock Grid.Column="2" Text="数值内容" VerticalAlignment="Center" Margin="20,0,0,0"/>
            <ComboBox x:Name="VerticalNumberComboBox" Grid.Column="3" SelectedValuePath="Content" SelectionChanged="VerticalContent_Changed">
              <ComboBoxItem Content="当前分数（持有点数）"/><ComboBoxItem Content="精算点"/>
            </ComboBox>
          </Grid>
        </GroupBox>

        <GroupBox x:Name="GapSettingsGroup" Header="分差与逆转设置" Margin="0,0,0,14" Padding="18,14">
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="80"/><ColumnDefinition Width="*"/><ColumnDefinition Width="100"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <TextBlock Text="展示选手" VerticalAlignment="Center"/>
            <ComboBox x:Name="GapPlayerComboBox" Grid.Column="1" SelectedValuePath="Tag" SelectionChanged="GapSettings_Changed"/>
            <TextBlock Grid.Column="2" Text="计算目标" VerticalAlignment="Center" Margin="20,0,0,0"/>
            <ComboBox x:Name="GapTargetComboBox" Grid.Column="3" SelectedValuePath="Content" SelectionChanged="GapSettings_Changed">
              <ComboBoxItem Content="逆转上一位"/><ComboBoxItem Content="逆转前二"/><ComboBoxItem Content="逆转一位"/>
            </ComboBox>
          </Grid>
        </GroupBox>

        <Grid Margin="2,6,2,14">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <TextBlock Text="选手数据" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
          <CheckBox x:Name="ShowTotalCheckBox" Grid.Column="1" Content="OBS 显示精算点" Checked="ShowTotal_Changed" Unchecked="ShowTotal_Changed"/>
        </Grid>
        <ItemsControl x:Name="PlayerEditorsControl" HorizontalContentAlignment="Stretch" Margin="-6,0,-6,4">
          <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="1" Columns="4"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Style="{StaticResource PlayerCardStyle}">
                <StackPanel>
                  <Grid Height="72">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="72"/></Grid.ColumnDefinitions>
                    <Border Background="#223B3A" BorderBrush="#3E6259" BorderThickness="1" CornerRadius="5" Padding="10,5" HorizontalAlignment="Left" VerticalAlignment="Top">
                      <TextBlock Text="{Binding SeatLabel}" Foreground="#9EE3CF" FontSize="12" FontWeight="SemiBold"/>
                    </Border>
                    <Border Grid.Column="1" Width="72" Height="72" CornerRadius="8" BorderBrush="#4E6578" BorderThickness="1"
                            Background="#20303E" ClipToBounds="True" ToolTip="已选头像预览，确认修改后播出">
                      <Grid>
                        <TextBlock Text="{Binding AvatarPreviewText}" FontSize="11" Foreground="{StaticResource AppMutedTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center">
                          <TextBlock.Style>
                            <Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/>
                              <Style.Triggers><DataTrigger Binding="{Binding AvatarPreview}" Value="{x:Null}"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                            </Style>
                          </TextBlock.Style>
                        </TextBlock>
                        <Image Source="{Binding AvatarPreview}" Stretch="UniformToFill">
                          <Image.OpacityMask><VisualBrush><VisualBrush.Visual><Border Background="White" CornerRadius="7" Width="70" Height="70"/></VisualBrush.Visual></VisualBrush></Image.OpacityMask>
                        </Image>
                      </Grid>
                    </Border>
                  </Grid>
                  <TextBlock Text="{Binding Name}" ToolTip="{Binding Name}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                             FontSize="19" FontWeight="SemiBold" Height="52" Margin="0,12,0,14"/>
                  <TextBlock Text="持有点数" Foreground="{StaticResource AppMutedTextBrush}" FontSize="12"/>
                  <TextBlock Text="{Binding ScoreDisplay}" FontFamily="{StaticResource NumericFont}" FontSize="38" Margin="0,4,0,14"/>
                  <Border Height="1" Background="#2D3C4C" Margin="0,0,0,14"/>
                  <TextBlock Text="此前累计精算点" Foreground="{StaticResource AppMutedTextBrush}" FontSize="12" Margin="0,0,0,8"/>
                  <TextBox Text="{Binding Total, UpdateSourceTrigger=PropertyChanged}" FontSize="18" FontFamily="{StaticResource NumericFont}" Height="40" Margin="0,0,0,16"
                           AutomationProperties.Name="{Binding SeatLabel, StringFormat={}{0} 此前累计精算点}"/>
                  <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Button Content="上传头像" Click="UploadAvatar_Click" ToolTip="{Binding AvatarStatus}" Padding="8,7" FontSize="12"
                            AutomationProperties.Name="{Binding SeatLabel, StringFormat={}{0} 上传头像}"/>
                    <Button Grid.Column="2" Content="选手设置" Click="OpenPlayerDetails_Click" Padding="8,7" FontSize="12"
                            AutomationProperties.Name="{Binding SeatLabel, StringFormat={}{0} 选手设置}"/>
                  </Grid>
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </ScrollViewer>

    <Border Grid.Row="3" Margin="0,18,0,0" Padding="18,15" BorderThickness="1" CornerRadius="10" Background="{StaticResource AppSurfaceBrush}">
      <Border.Style><Style TargetType="Border"><Setter Property="BorderBrush" Value="#344457"/>
        <Style.Triggers><DataTrigger Binding="{Binding IsEnabled, ElementName=ConfirmChangesButton}" Value="True"><Setter Property="BorderBrush" Value="#8B575D"/></DataTrigger></Style.Triggers>
      </Style></Border.Style>
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel Margin="0,0,22,0" VerticalAlignment="Center">
          <TextBlock x:Name="ChangeStatusText" Text="暂无待确认修改" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap"
                     AutomationProperties.Name="{Binding Text, RelativeSource={RelativeSource Self}}" AutomationProperties.LiveSetting="Polite"/>
          <TextBlock Text="选手资料与累计精算点统一保存" FontSize="12" Foreground="{StaticResource AppMutedTextBrush}" Margin="0,5,0,0"/>
          <TextBlock x:Name="PlayerInputStatusText" Foreground="#FF9BA1" TextWrapping="Wrap">
            <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Margin" Value="0,5,0,0"/>
              <Style.Triggers><Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger></Style.Triggers>
            </Style></TextBlock.Style>
          </TextBlock>
        </StackPanel>
        <Button x:Name="ConfirmChangesButton" Grid.Column="1" Content="确认修改" Click="ConfirmChanges_Click"
                Style="{StaticResource ConfirmChangesButtonStyle}" FontSize="15" Width="216" Height="46" IsEnabled="False" VerticalAlignment="Center"/>
      </Grid>
    </Border>

    <!-- 二级窗口首次打开时接管对应内容，继续复用现有控件与事件。 -->
    <Grid x:Name="DialogContentStore" Visibility="Collapsed">
      <StackPanel x:Name="ObservationControlContent">
        <GroupBox Header="账号登录" Padding="18" Margin="0,0,0,16">
          <StackPanel>
            <TextBlock x:Name="BackendStatusText" FontSize="12" Foreground="{StaticResource AppMutedTextBrush}" Text="观战后台：正在启动" TextWrapping="Wrap"/>
            <TextBlock x:Name="AccountStatusText" Margin="0,5,0,18" FontWeight="SemiBold" Text="雀魂账号：未登录" TextWrapping="Wrap"/>
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <StackPanel><TextBlock Text="账号" Margin="0,0,0,7" Foreground="{StaticResource AppMutedTextBrush}"/><TextBox x:Name="AccountNameTextBox" AutomationProperties.Name="雀魂账号"/></StackPanel>
              <StackPanel Grid.Column="2"><TextBlock Text="密码" Margin="0,0,0,7" Foreground="{StaticResource AppMutedTextBrush}"/><PasswordBox x:Name="PasswordInput" AutomationProperties.Name="雀魂密码"/></StackPanel>
            </Grid>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
              <Button x:Name="LogoutButton" Content="退出登录" Click="Logout_Click" Margin="0,0,10,0"/>
              <Button x:Name="LoginButton" Content="登录" Click="Login_Click" Padding="28,8" Background="#2B544D" BorderBrush="#69CFB2"/>
            </StackPanel>
          </StackPanel>
        </GroupBox>
        <GroupBox Header="大会对局" Padding="18">
          <StackPanel>
            <TextBlock x:Name="LoginRequiredText" Text="先完成登录，即可输入大会 ID 获取对局。" Foreground="#E4C386" Margin="0,0,0,14" TextWrapping="Wrap"/>
            <StackPanel x:Name="ContestAccessPanel" IsEnabled="False">
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="76"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock Text="大会 ID" VerticalAlignment="Center"/>
                <TextBox x:Name="ContestIdTextBox" Grid.Column="1" AutomationProperties.Name="大会 ID"/>
                <Button x:Name="FetchGamesButton" Grid.Column="2" Content="获取对局" Click="FetchGames_Click" Margin="12,0,0,0"/>
              </Grid>
              <Grid Margin="0,14,0,14">
                <ListBox x:Name="ContestGamesList" Height="156" DisplayMemberPath="Label" SelectionChanged="ContestGameSelection_Changed" AutomationProperties.Name="大会对局列表"/>
                <TextBlock Text="获取大会对局后，在这里选择要观战的场次" TextWrapping="Wrap" Margin="24" Foreground="{StaticResource AppMutedTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                  <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Items.Count, ElementName=ContestGamesList}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                </TextBlock>
              </Grid>
              <WrapPanel>
                <Button x:Name="StartObserveButton" Content="开始观战" Click="StartObserve_Click" Background="#2B544D" BorderBrush="#69CFB2"/>
                <Button x:Name="StopObserveButton" Content="停止观战" Click="StopObserve_Click" Margin="10,0,0,0"/>
                <Button Content="延迟/实时观战" Click="OpenObservationMode_Click" Margin="10,0,0,0"/>
              </WrapPanel>
            </StackPanel>
          </StackPanel>
        </GroupBox>
        <TextBlock x:Name="ControlStatusText" Margin="2,14,2,0" Foreground="#CBD8E5" TextWrapping="Wrap"/>
        <TextBlock x:Name="ApiDataStatusText" Margin="2,8,2,0" FontSize="12" Foreground="{StaticResource AppMutedTextBrush}" Text="数据：等待首个观战快照" TextWrapping="Wrap"/>
      </StackPanel>

      <StackPanel x:Name="ObservationModeContent">
        <TextBlock Text="观战方式" FontWeight="SemiBold" Margin="0,0,0,10"/>
        <ComboBox x:Name="ObserveModeComboBox" SelectedIndex="0">
          <ComboBoxItem Content="延迟观战" Tag="delayed"/><ComboBoxItem Content="实时观战" Tag="realtime"/>
        </ComboBox>
        <TextBlock Text="播出延迟时间（0～30 秒）" FontWeight="SemiBold" Margin="0,26,0,10"/>
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <TextBox x:Name="ApiDelayTextBox" TextChanged="ApiDelayText_Changed" FontSize="18" FontFamily="{StaticResource NumericFont}" AutomationProperties.Name="播出延迟秒数"/>
          <Button x:Name="ApplyApiDelayButton" Grid.Column="1" Content="延迟已应用" Margin="8,3,3,3" Click="ApplyApiDelay_Click" IsEnabled="False"/>
        </Grid>
        <TextBlock Margin="3,12,3,0" Foreground="#AAB3C0" TextWrapping="Wrap" Text="延迟/实时观战用于下一次开始观战；播出延迟需点击应用。"/>
        <TextBlock x:Name="ApiDelayStatusText" Margin="3,12,3,0" Foreground="#AAB3C0" TextWrapping="Wrap"/>
      </StackPanel>

      <StackPanel x:Name="ReportsContent">
        <TextBlock x:Name="ReportStatusText" Foreground="#AAB3C0" TextWrapping="Wrap" Text="等待新对局；报告保存在程序目录的 reports 文件夹。"/>
        <WrapPanel Margin="0,12,0,16">
          <Button Content="保存当前报告" Click="SaveCurrentReport_Click"/>
          <Button Content="打开报告目录" Click="OpenReportsFolder_Click" Margin="8,3,3,3"/>
        </WrapPanel>
        <Grid Height="340" Margin="0,0,0,14">
        <ListBox x:Name="RoundRecordsList" Margin="0" HorizontalContentAlignment="Stretch">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Border BorderBrush="#344457" BorderThickness="0,0,0,1" Padding="4,12">
                <StackPanel>
                  <TextBlock Text="{Binding Header}" Foreground="#9EE3CF" FontWeight="SemiBold" FontSize="16"/>
                  <TextBlock Text="{Binding ResultText}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,10,0,0"/>
                  <TextBlock Text="{Binding HandText}" LineHeight="22" TextWrapping="Wrap" Foreground="#CBD3DF" Margin="0,5,0,0"/>
                  <TextBlock Text="{Binding FanText}" LineHeight="22" TextWrapping="Wrap" Foreground="#CBD3DF" Margin="0,5,0,0"/>
                  <TextBlock Text="{Binding ScoreText}" TextWrapping="Wrap" Foreground="#AAB3C0" Margin="0,5,0,0"/>
                </StackPanel>
              </Border>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
          <StackPanel x:Name="RoundRecordsEmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
            <TextBlock Text="暂无逐局记录" FontSize="17" FontWeight="SemiBold" Foreground="#CBD3DF" HorizontalAlignment="Center"/>
            <TextBlock Text="开始观战后，和牌与流局明细会自动显示在这里。" Foreground="#AAB3C0" TextWrapping="Wrap" Margin="0,9,0,0"/>
          </StackPanel>
        </Grid>
        <TextBlock Text="从开始观战时记录逐局结算。未接收到的详情显示“未提供”，不会根据分数变化猜测。"
                   TextWrapping="Wrap" Foreground="#AAB3C0" Margin="3,0,3,12"/>
        <Button Content="按当前结果填入下一场累计" Click="StageProjectedTotals_Click" HorizontalAlignment="Left"/>
        <TextBlock Margin="3,8,3,0" Foreground="#AAB3C0" TextWrapping="Wrap" Text="填入后点击“确认修改”，即可同步选手资料与精算点。"/>
      </StackPanel>

      <Grid x:Name="PreviewContent">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,10">
          <CheckBox DockPanel.Dock="Right" Content="窗口置顶" IsChecked="{Binding Topmost, RelativeSource={RelativeSource AncestorType=Window}, Mode=TwoWay}"/>
          <TextBlock Text="1920 × 1080 OBS 实时预览" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
        </DockPanel>
        <Border Grid.Row="1" BorderBrush="#909090" BorderThickness="1" Background="#333840">
          <Grid x:Name="PreviewHost" SizeChanged="PreviewHost_SizeChanged">
            <wv2:WebView2 x:Name="PreviewWebView" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            <TextBlock x:Name="PreviewErrorText" Visibility="Collapsed" Foreground="White" Background="#CC20242A"
                       TextAlignment="Center" TextWrapping="Wrap" Padding="24" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Grid>
        </Border>
      </Grid>

      <!-- 保留旧版素材配置控件以兼容旧配置，当前样式不再提供横排入口。 -->
      <StackPanel Visibility="Collapsed">
          <GroupBox x:Name="EventCopyGroup" Header="赛事文案" Margin="0,0,0,10" Padding="8">
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
              <TextBlock Text="部门" VerticalAlignment="Center" />
              <TextBox x:Name="DepartmentTextBox" Grid.Column="1" TextChanged="TextSettings_Changed" />
              <TextBlock Grid.Row="1" Text="当前回战" VerticalAlignment="Center" />
              <TextBox x:Name="MatchTextBox" Grid.Row="1" Grid.Column="1" TextChanged="TextSettings_Changed" />
            </Grid>
          </GroupBox>

          <GroupBox x:Name="LiveAssetsGroup" Header="直播素材" Margin="0,0,0,10" Padding="8">
            <StackPanel>
              <WrapPanel>
                <Button Content="上传左侧底板" Tag="left-board" Click="UploadAsset_Click"/>
                <Button Content="重置取景" Tag="left-board" Click="ResetAssetPosition_Click" Margin="6,0,0,0"/>
                <TextBlock x:Name="LeftBoardStatus" VerticalAlignment="Center"/>
              </WrapPanel>
              <TextBlock Margin="4,6,0,2" Text="左侧底板取景焦点（决定裁切时显示哪一部分）" />
              <Grid Margin="4,0,4,8">
                <Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition Width="*"/><ColumnDefinition Width="48"/></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                <TextBlock Text="水平" VerticalAlignment="Center"/>
                <Slider x:Name="LeftBoardFocusXSlider" Grid.Column="1" Minimum="0" Maximum="100" TickFrequency="5" ValueChanged="LeftBoardFocus_Changed" PreviewMouseLeftButtonUp="LeftBoardFocus_Commit" LostFocus="LeftBoardFocus_Commit"/>
                <TextBlock x:Name="LeftBoardFocusXValue" Grid.Column="2" TextAlignment="Right" VerticalAlignment="Center"/>
                <TextBlock Grid.Row="1" Text="垂直" VerticalAlignment="Center"/>
                <Slider x:Name="LeftBoardFocusYSlider" Grid.Row="1" Grid.Column="1" Minimum="0" Maximum="100" TickFrequency="5" ValueChanged="LeftBoardFocus_Changed" PreviewMouseLeftButtonUp="LeftBoardFocus_Commit" LostFocus="LeftBoardFocus_Commit"/>
                <TextBlock x:Name="LeftBoardFocusYValue" Grid.Row="1" Grid.Column="2" TextAlignment="Right" VerticalAlignment="Center"/>
              </Grid>
              <WrapPanel>
                <Button Content="上传 Logo" Tag="logo" Click="UploadAsset_Click"/>
                <Button Content="重置位置" Tag="logo" Click="ResetAssetPosition_Click" Margin="6,0,0,0"/>
                <TextBlock x:Name="LogoStatus" VerticalAlignment="Center"/>
              </WrapPanel>
              <TextBlock Margin="4,6,0,2" Text="Logo 布局（X / Y / 宽 / 高）" />
              <WrapPanel>
                <TextBox x:Name="LogoX" Width="72" TextChanged="LayoutText_Changed"/><TextBox x:Name="LogoY" Width="72" TextChanged="LayoutText_Changed"/>
                <TextBox x:Name="LogoW" Width="72" TextChanged="LayoutText_Changed"/><TextBox x:Name="LogoH" Width="72" TextChanged="LayoutText_Changed"/>
                <CheckBox x:Name="LogoLock" Content="锁定比例" Checked="LayoutText_Changed" Unchecked="LayoutText_Changed"/>
              </WrapPanel>
              <WrapPanel Margin="0,8,0,0">
                <Button Content="上传左下图片" Tag="bottom-left" Click="UploadAsset_Click"/>
                <Button Content="重置位置" Tag="bottom-left" Click="ResetAssetPosition_Click" Margin="6,0,0,0"/>
                <TextBlock x:Name="BottomLeftStatus" VerticalAlignment="Center"/>
              </WrapPanel>
              <TextBlock Margin="4,6,0,2" Text="左下图片布局（X / Y / 宽 / 高）" />
              <WrapPanel>
                <TextBox x:Name="BottomX" Width="72" TextChanged="LayoutText_Changed"/><TextBox x:Name="BottomY" Width="72" TextChanged="LayoutText_Changed"/>
                <TextBox x:Name="BottomW" Width="72" TextChanged="LayoutText_Changed"/><TextBox x:Name="BottomH" Width="72" TextChanged="LayoutText_Changed"/>
                <CheckBox x:Name="BottomLock" Content="锁定比例（默认关闭）" Checked="LayoutText_Changed" Unchecked="LayoutText_Changed"/>
              </WrapPanel>
              <TextBlock Margin="4,4,0,0" Foreground="#AAB3C0" Text="Logo 和左下图片也可直接在右侧预览中拖动。" />
            </StackPanel>
          </GroupBox>
      </StackPanel>
    </Grid>
  </Grid>
</Window>
